# UI Component Patterns and Best Practices

## Avatar and User Interface Components

### 1. User Avatar Component

Create reusable avatar components that display user initials:

```typescript
const UserAvatar = Shade<{ username: string; onClick?: () => void }>({
  shadowDomName: 'user-avatar',
  render: ({ props }) => {
    const firstLetter = props.username?.charAt(0)?.toUpperCase() || '?'

    return (
      <div
        onclick={props.onClick}
        style={{
          width: '32px',
          height: '32px',
          borderRadius: '50%',
          backgroundColor: '#2196f3',
          display: 'flex',
          alignItems: 'center',
          justifyContent: 'center',
          fontSize: '14px',
          fontWeight: 'bold',
          color: 'white',
          cursor: 'pointer',
          userSelect: 'none',
          transition: 'all 0.2s ease',
        }}
      >
        {firstLetter}
      </div>
    )
  }
})
```

### 2. Dropdown Menu Pattern

Implement dropdown menus with click-outside functionality:

```typescript
const DropdownMenu = Shade({
  render: ({ injector, useObservable, useDisposable }) => {
    const isMenuOpen = useDisposable('isMenuOpen', () => new ObservableValue(false))

    return (
      <div style={{ position: 'relative' }}>
        <UserAvatar onClick={() => isMenuOpen.setValue(!isMenuOpen.getValue())} />

        {isMenuOpen.getValue() && (
          <>
            {/* Dropdown content */}
            <div style={{
              position: 'absolute',
              top: '40px',
              right: '0',
              backgroundColor: 'var(--theme-background-default)',
              border: '1px solid var(--theme-border-default)',
              borderRadius: '8px',
              boxShadow: '0 4px 12px rgba(0, 0, 0, 0.15)',
              minWidth: '160px',
              zIndex: '1000',
            }}>
              {/* Menu items */}
            </div>

            {/* Click-outside overlay */}
            <div
              style={{
                position: 'fixed',
                top: '0',
                left: '0',
                width: '100vw',
                height: '100vh',
                zIndex: '999',
              }}
              onclick={() => isMenuOpen.setValue(false)}
            />
          </>
        )}
      </div>
    )
  }
})
```

## Form Handling Patterns

### 1. Password Reset Form

Handle sensitive forms with proper validation and error states:

```typescript
type PasswordResetPayload = {
  currentPassword: string
  newPassword: string
  confirmPassword: string
}

const PasswordResetForm = Shade({
  render: ({ injector, useDisposable }) => {
    const session = injector.getInstance(SessionService)
    const notyService = injector.getInstance(NotyService)

    const isLoading = useDisposable('isLoading', () => new ObservableValue(false))
    const error = useDisposable('error', () => new ObservableValue<string>(''))

    const handleSubmit = async (data: PasswordResetPayload) => {
      // Client-side validation
      if (data.newPassword !== data.confirmPassword) {
        error.setValue('New passwords do not match')
        return
      }

      isLoading.setValue(true)
      error.setValue('')

      try {
        await session.resetPassword(data.currentPassword, data.newPassword)

        // Clear form after success
        const form = document.querySelector('form[data-form-id]') as HTMLFormElement
        form?.reset()
      } catch (err: unknown) {
        const errorMessage = err instanceof Error ? err.message : 'Operation failed'
        error.setValue(errorMessage)
        notyService.emit('onNotyAdded', {
          title: 'Error',
          body: errorMessage,
          type: 'error',
        })
      } finally {
        isLoading.setValue(false)
      }
    }

    return (
      <Form<PasswordResetPayload>
        validate={(data): data is PasswordResetPayload => {
          return !!(
            (data as PasswordResetPayload)?.currentPassword?.length &&
            (data as PasswordResetPayload)?.newPassword?.length &&
            (data as PasswordResetPayload)?.confirmPassword?.length
          )
        }}
        onSubmit={(data) => void handleSubmit(data)}
        data-form-id
      >
        <Input
          labelTitle="Current Password"
          name="currentPassword"
          type="password"
          required
        />

        <Input
          labelTitle="New Password"
          name="newPassword"
          type="password"
          required
        />

        <Input
          labelTitle="Confirm New Password"
          name="confirmPassword"
          type="password"
          required
        />

        {error.getValue() && (
          <div style={{
            color: 'var(--theme-error-main)',
            fontSize: '14px',
            padding: '8px',
            backgroundColor: 'var(--theme-error-light)',
            borderRadius: '4px',
            marginBottom: '16px',
          }}>
            {error.getValue()}
          </div>
        )}

        <Button
          type="submit"
          variant="contained"
          color="primary"
          disabled={isLoading.getValue()}
        >
          {isLoading.getValue() ? 'Processing...' : 'Update Password'}
        </Button>
      </Form>
    )
  }
})
```

### 2. Form Validation Best Practices

- **Client-side validation**: Basic checks like password confirmation matching
- **Server-side validation**: Complex business rules and security policies
- **Progressive enhancement**: Don't duplicate server validation on client
- **Clear error messaging**: Show specific, actionable error messages
- **Loading states**: Disable form and show loading during submission
- **Success feedback**: Clear form and show success notification

## Settings Page Organization

### 1. Section-Based Layout

Organize settings into logical sections:

```typescript
const UserSettingsPage = Shade({
  render: ({ injector, useObservable }) => {
    const session = injector.getInstance(SessionService)
    const [currentUser] = useObservable('currentUser', session.currentUser)

    if (!currentUser) {
      return <div>Please log in to access user settings.</div>
    }

    return (
      <div style={{
        padding: '24px',
        maxWidth: '800px',
        margin: '0 auto'
      }}>
        <h1 style={{
          marginBottom: '32px',
          color: 'var(--theme-text-primary)',
          borderBottom: '2px solid var(--theme-primary-main)',
          paddingBottom: '8px'
        }}>
          User Settings
        </h1>

        <ProfileSection />      {/* Read-only user information */}
        <SecuritySection />     {/* Password reset, 2FA, etc. */}
        <PreferencesSection />  {/* User preferences */}
        <NotificationSection /> {/* Notification settings */}
      </div>
    )
  }
})
```

### 2. Section Component Pattern

Create separate components for each settings section:

```typescript
const ProfileSection = Shade({
  render: ({ injector, useObservable }) => {
    const session = injector.getInstance(SessionService)
    const [currentUser] = useObservable('currentUser', session.currentUser)

    return (
      <div>
        <h3>👤 Profile</h3>

        <Paper elevation={1} style={{ padding: '24px' }}>
          <div style={{ marginBottom: '16px' }}>
            <label style={{
              display: 'block',
              fontSize: '14px',
              fontWeight: 'bold',
              marginBottom: '4px',
              color: 'var(--theme-text-secondary)',
            }}>
              Username
            </label>
            <div style={{
              padding: '8px 12px',
              backgroundColor: 'var(--theme-background-paper)',
              border: '1px solid var(--theme-border-default)',
              borderRadius: '4px',
              color: 'var(--theme-text-primary)',
            }}>
              {currentUser?.username}
            </div>
          </div>

          {/* Additional profile fields */}
        </Paper>
      </div>
    )
  }
})
```

## State Management Patterns

### 1. Component State with Observables

Use ObservableValue for component-specific state:

```typescript
const StatefulComponent = Shade({
  render: ({ useDisposable, useObservable }) => {
    // Component-specific state
    const isLoading = useDisposable('isLoading', () => new ObservableValue(false))
    const error = useDisposable('error', () => new ObservableValue<string>(''))
    const selectedTab = useDisposable('selectedTab', () => new ObservableValue('profile'))

    // Global state subscriptions
    const session = injector.getInstance(SessionService)
    const [currentUser] = useObservable('currentUser', session.currentUser)

    // Component logic...
  },
})
```

### 2. Loading and Error States

Handle async operations with proper state management:

```typescript
const AsyncComponent = Shade({
  render: ({ useDisposable }) => {
    const isLoading = useDisposable('isLoading', () => new ObservableValue(false))
    const error = useDisposable('error', () => new ObservableValue<string>(''))
    const data = useDisposable('data', () => new ObservableValue(null))

    const loadData = async () => {
      isLoading.setValue(true)
      error.setValue('')

      try {
        const result = await someAsyncOperation()
        data.setValue(result)
      } catch (err: unknown) {
        const errorMessage = err instanceof Error ? err.message : 'Failed to load data'
        error.setValue(errorMessage)
      } finally {
        isLoading.setValue(false)
      }
    }

    // Render loading, error, or success states...
  },
})
```

