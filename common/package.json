{
  "name": "common",
  "version": "1.0.14",
  "license": "GPL-2.0-only",
  "private": true,
  "type": "module",
  "exports": {
    ".": {
      "import": "./dist/index.js",
      "types": "./dist/index.d.ts"
    },
    "./schemas/*": {
      "import": "./schemas/*"
    },
    "./package.json": "./package.json"
  },
  "typesVersions": {
    "*": {
      "*": [
        "dist/*"
      ]
    }
  },
  "scripts": {
    "create-schemas": "node ./dist/bin/create-schemas.js"
  },
  "devDependencies": {
    "@types/node": "^25.6.0",
    "ts-json-schema-generator": "^2.9.0",
    "vitest": "^4.1.5"
  },
  "dependencies": {
    "@furystack/core": "^17.0.0",
    "@furystack/entity-sync": "^2.0.0",
    "@furystack/rest": "^10.0.0",
    "ollama": "^0.6.3"
  }
}
